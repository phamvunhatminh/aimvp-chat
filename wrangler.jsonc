{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aimvp-chat",
  "compatibility_date": "2026-10-01",
  // Static SPA: no Worker script yet. Unknown paths fall back to index.html.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Every deploy makes this list the Worker's only custom domains: add or
  // remove domains here, not in the dashboard, or the next deploy undoes it.
  // chat.aimvp.app stays while users move their chats over: each origin keeps
  // its own browser storage, so the old one is how they reach theirs.
  "routes": [
    { "pattern": "askinghere.com", "custom_domain": true },
    { "pattern": "chat.aimvp.app", "custom_domain": true }
  ],
  // Enables `wrangler preview`, which Cloudflare's Git integration runs for
  // non-production branches. Settings above are inherited.
  "previews": {}
}
